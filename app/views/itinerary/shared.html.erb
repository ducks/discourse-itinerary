<% content_for :title do %><%= @trip.title %><% end %>

<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.5; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #222; }
  h1 { margin: 0 0 0.25rem; font-size: 1.6rem; }
  .meta { color: #666; font-size: 0.9rem; margin-bottom: 1.5rem; }
  .day { margin-bottom: 1.25rem; }
  .day-heading { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: #666; border-bottom: 1px dashed #ccc; padding-bottom: 0.2rem; margin-bottom: 0.4rem; }
  .item { display: grid; grid-template-columns: 5rem auto 1fr auto; gap: 0.6rem; align-items: baseline; padding: 0.35rem 0; }
  .item + .item { border-top: 1px dotted #eee; }
  .time { font-variant-numeric: tabular-nums; color: #555; font-size: 0.9rem; }
  .type { font-size: 0.75rem; text-transform: uppercase; color: #888; letter-spacing: 0.04em; }
  .title { font-weight: 500; }
  .route, .location { color: #555; font-size: 0.9rem; }
  .empty { color: #888; font-style: italic; }
  .footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #eee; color: #888; font-size: 0.85rem; }
</style>

<h1><%= @trip.title %></h1>
<p class="meta">
  <% if @trip.starts_at %>
    <%= @trip.starts_at %><% if @trip.ends_at %> to <%= @trip.ends_at %><% end %>
  <% end %>
  <% if @trip.location %>
    &middot; <%= @trip.location %>
  <% end %>
</p>

<%
  # Group items by their YYYY-MM-DD prefix. The items list comes in
  # already sorted by starts_at so a single pass is enough.
  by_day = @items.each_with_object({}) do |item, h|
    starts_at = item.custom_fields["itinerary_starts_at"].to_s
    day = starts_at.slice(0, 10)
    next if day.empty?
    (h[day] ||= []) << item
  end
%>

<% if by_day.empty? %>
  <p class="empty">This trip has no items yet.</p>
<% end %>

<% by_day.each do |day, items| %>
  <section class="day">
    <h3 class="day-heading"><%= day %></h3>
    <% items.each do |item| %>
      <%
        starts_at = item.custom_fields["itinerary_starts_at"].to_s
        time_str = starts_at.include?("T") ? starts_at.split("T")[1].to_s.slice(0, 5) : ""
        type      = item.custom_fields["itinerary_item_type"]
        origin    = item.custom_fields["itinerary_origin"]
        destination = item.custom_fields["itinerary_destination"]
        name      = item.custom_fields["itinerary_name"]
        location  = item.custom_fields["itinerary_location"]
      %>
      <div class="item">
        <span class="time"><%= time_str %></span>
        <span class="type"><%= type %></span>
        <span class="title"><%= name.presence || item.title %></span>
        <% if origin.present? && destination.present? %>
          <span class="route"><%= origin %> &rarr; <%= destination %></span>
        <% elsif location.present? %>
          <span class="location"><%= location %></span>
        <% else %>
          <span></span>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<p class="footer">Read-only shared itinerary.</p>
